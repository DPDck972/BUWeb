        "from pydantic import BaseModel, Field\n",
        "import re\n",
        "import json\n",
        "from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage\n",
        "from langgraph.graph import StateGraph, START, END\n",
        "\n",
        "\n",
        "class Problema(BaseModel):\n",
        "    afirmacao: str = Field(description=\"the wrong claim, copied from the answer\")\n",
        "    evidencia: str = Field(description=\"the tool result that contradicts the claim, quoted with its zone/section and numbers\")\n",
        "\n",
        "\n",
        "class Revisao(BaseModel):\n",
        "    problemas: list[Problema] = Field(description=\"wrong claims; empty list if the answer is correct\")\n",
        "\n",
        "\n",
        "VERIFICADOR = \"\"\"You are a strict fact checker for an election audit assistant. You get the user's request,\n",
        "the tool calls and results, and the assistant's answer. The tool results are the only source of truth.\n",
        "Report a problem only when a tool result contradicts a claim in the answer\n",
        "(a number of votes, voters, blank/nominal/null votes, attendance/absenteeism or zone/section numbers).\n",
        "Also report a problem if a section cited in the assistant's answer is reported as not found or invalid by the tool results.\n",
        "Check every sum of votes and attendance figures against the numbers.\n",
        "When compare_secoes was called, its results are the ground truth.\n",
        "If the answer is correct, return an empty list.\"\"\"\n",
        "\n",
        "\n",
        "def trajetoria(msgs):\n",
        "    \"\"\"As chamadas de ferramenta e os resultados, em texto, para o verificador ler.\"\"\"\n",
        "    linhas = []\n",
        "    for m in msgs:\n",
        "        if isinstance(m, AIMessage):\n",
        "            linhas += [f\"CALL {c['name']}({json.dumps(c['args'], ensure_ascii=False)})\" for c in m.tool_calls]\n",
        "        elif isinstance(m, ToolMessage):\n",
        "            linhas.append(f\"RESULT {texto(m.content)}\")\n",
        "    return \"\\n\".join(linhas)\n",
        "\n",
        "\n",
        "def secoes_citadas(texto):\n",
        "    \"\"\"Extrai pares (zona, secao) em qualquer ordem: 'Zona 3, Seção 504', 'seção 505 da zona 3', '3/504'.\"\"\"\n",
        "    pares = set()\n",
        "    # \"Zona 3, Seção 504\" / \"zona 3 seção 504\"\n",
        "    pares |= set(re.findall(r\"zona\\s*(\\d+)[^\\d]*se[çc][ãa]o\\s*(\\d+)\", texto, re.I))\n",
        "    # \"seção 505 da zona 3\" / \"seção 505, zona 3\"\n",
        "    pares |= set(re.findall(r\"se[çc][ãa]o\\s*(\\d+)[^\\d]*zona\\s*(\\d+)\", texto, re.I))\n",
        "    # \"3/504\"\n",
        "    pares |= set(re.findall(r\"\\b(\\d{1,3})/(\\d{1,4})\\b\", texto))\n",
        "    # \"seções 505 e 504 da zona 3\"\n",
        "    for m in re.finditer(r\"se[çc][õo]es?\\s+([\\d\\s,e]+?)\\s+da\\s+zona\\s+(\\d+)\", texto, re.I):\n",
        "        zona = m.group(2)\n",
        "        for secao in re.findall(r\"\\d+\", m.group(1)):\n",
        "            pares.add((zona, secao))\n",
        "    return pares\n",
        "\n",
        "\n",
        "def secoes_da_pergunta(texto):\n",
        "    return secoes_citadas(texto)\n",
        "\n",
        "\n",
        "def operacao_pedida(pergunta):\n",
        "    \"\"\"Detecta a operação que a pergunta exige: soma, minimo, maximo ou None.\"\"\"\n",
        "    p = pergunta.lower()\n",
        "    # comparação vem primeiro: \"menos\"/\"mais\" são mais específicos que \"total\"\n",
        "    if re.search(r\"\\bmenos\\b|\\bmenor\\b|\\bmínimo\\b|\\bminimo\\b\", p):\n",
        "        return \"minimo\"\n",
        "    if re.search(r\"\\bmais\\b|\\bmaior\\b|\\bmáximo\\b|\\bmaximo\\b\", p):\n",
        "        return \"maximo\"\n",
        "    # soma só quando o verbo é explícito, não quando aparece \"total geral\"\n",
        "    if re.search(r\"\\bsom(a|ando|ar|e)\\b|\\bjunt[oa]s?\\b|\\bcombinad[oa]s?\\b\", p):\n",
        "        return \"soma\"\n",
        "    return None\n",
        "\n",
        "\n",
        "def tem_evidencia(evidencia, resultados):\n",
        "    \"\"\"Cada número da evidência precisa aparecer nos resultados, exceto em evidências estruturais.\"\"\"\n",
        "    baixa =  evidencia.lower()\n",
        "    # evidências que não são numéricas por natureza\n",
        "    if (\"não encontrada\" in baixa or \"error\" in baixa\n",
        "            or \"pergunta cita\" in baixa or \"pergunta pede\" in baixa):\n",
        "        return True\n",
        "    fatos = re.findall(r\"\\d+(?:\\.\\d+)?\",  evidencia)\n",
        "    return bool(fatos) and all(f in resultados.replace(\" \", \"\") for f in fatos)\n",
        "\n",
        "\n",
        "def gerador_verificador(ferramentas, max_revisoes=2):\n",
        "    detalhes = {t.name: t for t in ferramentas}[\"secao_details\"]\n",
        "    gerador = modelo().bind_tools(ferramentas)\n",
        "    juiz = modelo(pensar=True, max_tokens=4000).with_structured_output(Revisao)\n",
        "\n",
        "    async def no_gerador(estado):\n",
        "        return {\"messages\": [await chamar(gerador, [SystemMessage(SYSTEM)] + estado[\"messages\"])]}\n",
        "\n",
        "    async def no_verificador(estado):\n",
        "        msgs = estado[\"messages\"]\n",
        "        pergunta = msgs[0].content\n",
        "        resposta = msgs[-1].content\n",
        "\n",
        "        secoes_pergunta = secoes_da_pergunta(pergunta)\n",
        "        secoes_resposta = secoes_citadas(resposta)\n",
        "        op = operacao_pedida(pergunta)\n",
        "        ferramentas_usadas = {c[\"name\"] for m in msgs if isinstance(m, AIMessage) for c in m.tool_calls}\n",
        "\n",
        "        problemas_proativos = []\n",
        "\n",
        "        # 1) desvio: a resposta não trata das seções pedidas\n",
        "        if secoes_pergunta and not secoes_pergunta.issubset(secoes_resposta):\n",
        "            faltando = secoes_pergunta - secoes_resposta\n",
        "            problemas_proativos.append(Problema(\n",
        "                afirmacao=\"A resposta não trata das seções pedidas na pergunta\",\n",
        "                evidencia=f\"Pergunta cita {sorted(secoes_pergunta)}; resposta cita {sorted(secoes_resposta)}\"\n",
        "            ))\n",
        "\n",
        "        # 2) operação errada: a pergunta pede soma e a resposta não somou\n",
        "        if op == \"soma\" and \"soma_secoes\" not in ferramentas_usadas:\n",
        "            problemas_proativos.append(Problema(\n",
        "                afirmacao=\"A pergunta pede uma soma, mas a resposta não somou os votos\",\n",
        "                evidencia=f\"Pergunta pede soma; ferramentas chamadas: {sorted(ferramentas_usadas)}\"\n",
        "            ))\n",
        "\n",
        "        consultas = []\n",
        "        ids_secoes = []\n",
        "\n",
        "        for z, s in sorted(secoes_resposta):\n",
        "            ids_secoes.append(f\"{z}/{s}\")\n",
        "            info_secao = await detalhes.ainvoke({'zona': z, 'secao': s})\n",
        "            texto_resultado = texto(info_secao)\n",
        "            consultas.append(f\"CALL secao_details(zona={z}, secao={s})\\nRESULT {texto_resultado}\")\n",
        "\n",
        "            try:\n",
        "                dados_json = json.loads(texto_resultado)\n",
        "                if isinstance(dados_json, dict) and \"error\" in dados_json:\n",
        "                    problemas_proativos.append(Problema(\n",
        "                        afirmacao=f\"Menção à seção {z}/{s} na resposta\",\n",
        "                        evidencia=f\"Erro retornado pelo servidor: {dados_json['error']}\"\n",
        "                    ))\n",
        "            except Exception:\n",
        "                if \"error\" in texto_resultado.lower() or \"não encontrada\" in texto_resultado.lower():\n",
        "                    problemas_proativos.append(Problema(\n",
        "                        afirmacao=f\"Menção à seção {z}/{s} na resposta\",\n",
        "                        evidencia=f\"Erro retornado pelo servidor: {texto_resultado}\"\n",
        "                    ))\n",
        "\n",
        "        resultados = trajetoria(msgs) + \"\\n\" + \"\\n\".join(consultas)\n",
        "        rev = await chamar(juiz, [SystemMessage(VERIFICADOR), HumanMessage(\n",
        "            f\"USER REQUEST:\\n{pergunta}\\n\\nTOOL CALLS AND RESULTS:\\n{resultados}\\n\\nASSISTANT ANSWER:\\n{resposta}\")])\n",
        "\n",
        "        todos_problemas = rev.problemas + problemas_proativos\n",
        "        validos = [p for p in todos_problemas if tem_evidencia(p.evidencia, resultados)]\n",
        "        descartados = len(todos_problemas) - len(validos)\n",
        "\n",
        "        # ─── CORREÇÃO 1: objeção repetida encerra o ciclo ───────────────────\n",
        "        anteriores = set()\n",
        "        for m in msgs:\n",
        "            if isinstance(m, HumanMessage) and m.name == \"verificador\":\n",
        "                anteriores |= set(re.findall(r'- \"([^\"]+)\"', m.content))\n",
        "        novas = [p for p in validos if p.afirmacao not in anteriores]\n",
        "\n",
        "        if not validos or not novas:\n",
        "            # ─── CORREÇÃO 2: devolve a RESPOSTA ORIGINAL, não a mensagem de status ───\n",
        "            status = f\"consultou {', '.join(ids_secoes) or 'nada'}; ok\"\n",
        "            if descartados:\n",
        "                status += f\" ({descartados} objeção sem evidência descartada)\"\n",
        "            if validos and not novas:\n",
        "                status += \" (objeção repetida, encerrando)\"\n",
        "            return {\"messages\": [AIMessage(resposta, name=\"verificador\")]}\n",
        "\n",
        "        retorno = \"A reviewer found these problems. Fix them, calling tools again if needed, and rewrite the answer:\\n\"\n",
        "        retorno += \"\\n\".join(f'- \"{p.afirmacao}\" is contradicted by: {p.evidencia}' for p in validos)\n",
        "        return {\"messages\": [HumanMessage(retorno, name=\"verificador\")]}\n",
        "\n",
        "    def depois_do_gerador(estado):\n",
        "        return \"ferramentas\" if estado[\"messages\"][-1].tool_calls else \"verificador\"\n",
        "\n",
        "    def depois_do_verificador(estado):\n",
        "        revisoes = sum(1 for m in estado[\"messages\"] if isinstance(m, HumanMessage) and m.name == \"verificador\")\n",
        "        aprovado = isinstance(estado[\"messages\"][-1], AIMessage)\n",
        "        return END if aprovado or revisoes > max_revisoes else \"gerador\"\n",
        "\n",
        "    g = StateGraph(Estado)\n",
        "    g.add_node(\"gerador\", no_gerador)\n",
        "    g.add_node(\"ferramentas\", ToolNode(ferramentas, handle_tool_errors=True))\n",
        "    g.add_node(\"verificador\", no_verificador)\n",
        "    g.add_edge(START, \"gerador\")\n",
        "    g.add_conditional_edges(\"gerador\", depois_do_gerador, [\"ferramentas\", \"verificador\"])\n",
        "    g.add_edge(\"ferramentas\", \"gerador\")\n",
        "    g.add_conditional_edges(\"verificador\", depois_do_verificador, [\"gerador\", END])\n",
        "    return g.compile()\n",
        "\n",
        "\n",
        "dupla = gerador_verificador(TOOLS)\n",
        "print(\"gerador + verificador pronto com validação proativa de seções inexistentes\")"
      ]
