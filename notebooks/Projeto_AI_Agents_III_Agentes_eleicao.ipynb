        "# @title 🔎 Inspeção dos dados baixados\n",
        "# Exibe a estrutura do CSV e amostras dos cargos trabalhados na análise.\n",
        "print(f\"Arquivo inspecionado: {ARQUIVO_ORIGINAL}\")\n",
        "\n",
        "# Lê apenas uma amostra para exibir o cabeçalho e os primeiros registros.\n",
        "amostra = pd.read_csv(\n",
        "    ARQUIVO_ORIGINAL,\n",
        "    sep=SEPARADOR,\n",
        "    encoding=ENCODING_ORIGINAL,\n",
        "    dtype=str,\n",
        "    keep_default_na=False,\n",
        "    nrows=5,\n",
        ")\n",
        "\n",
        "print(f\"\\nNúmero de colunas: {len(amostra.columns)}\")\n",
        "print(\"Cabeçalho:\")\n",
        "print(list(amostra.columns))\n",
        "\n",
        "# Conta todas as linhas sem carregar o arquivo completo na memória.\n",
        "linhas_totais = 0\n",
        "for bloco in pd.read_csv(\n",
        "    ARQUIVO_ORIGINAL,\n",
        "    sep=SEPARADOR,\n",
        "    encoding=ENCODING_ORIGINAL,\n",
        "    dtype=str,\n",
        "    keep_default_na=False,\n",
        "    usecols=[amostra.columns[0]],\n",
        "    chunksize=200_000,\n",
        "    low_memory=False,\n",
        "):\n",
        "    linhas_totais += len(bloco)\n",
        "\n",
        "print(f\"\\nNúmero de linhas: {linhas_totais:,}\")\n",
        "print(\"\\nDez primeiros registros do arquivo:\")\n",
        "display(amostra)\n",
        "\n",
        "# O arquivo de 2026 usa DS_CARGO; versões anteriores podem usar\n",
        "# DS_CARGO_PERGUNTA. Mostra uma amostra específica dos cargos analisados.\n",
        "coluna_cargo = next(\n",
        "    (coluna for coluna in (\"DS_CARGO_PERGUNTA\", \"DS_CARGO\") if coluna in amostra.columns),\n",
        "    None,\n",
        ")\n",
        "if coluna_cargo:\n",
        "    cargos_alvo = {\"Governador\", \"Presidente\"}\n",
        "    encontrados = []\n",
        "    for bloco in pd.read_csv(\n",
        "        ARQUIVO_ORIGINAL,\n",
        "        sep=SEPARADOR,\n",
        "        encoding=ENCODING_ORIGINAL,\n",
        "        dtype=str,\n",
        "        keep_default_na=False,\n",
        "        usecols=lambda coluna: coluna in {coluna_cargo, \"NR_TURNO\"},\n",
        "        chunksize=200_000,\n",
        "        low_memory=False,\n",
        "    ):\n",
        "        filtro = bloco[coluna_cargo].isin(cargos_alvo)\n",
        "        if \"NR_TURNO\" in bloco.columns:\n",
        "            filtro &= bloco[\"NR_TURNO\"].astype(str).str.strip().eq(str(TURNO))\n",
        "        encontrados.append(bloco.loc[filtro].head(5))\n",
        "        if sum(len(item) for item in encontrados) >= 10:\n",
        "            break\n",
        "\n",
        "    cargos_amostra = pd.concat(encontrados, ignore_index=True).head(5) if encontrados else pd.DataFrame()\n",
        "    print(f\"\\nAmostra de Governador/Presidente ({coluna_cargo}):\")\n",
        "    display(cargos_amostra)\n",
        "else:\n",
        "    print(\"\\nA coluna de cargo não foi encontrada no arquivo baixado.\")"
      ]
    },
