        "# Resumo final totalmente dinâmico\n",
        "if \"resultados\" not in globals() or not isinstance(resultados, pd.DataFrame) or resultados.empty:\n",
        "    raise RuntimeError(\"Execute as celulas de benchmark antes de gerar o resumo dinamico.\")\n",
        "\n",
        "res = resultados.copy()\n",
        "if \"framework\" not in res.columns:\n",
        "    res[\"framework\"] = \"LangGraph\"\n",
        "\n",
        "# Normaliza nome para evitar variacoes entre acentuado e sem acento.\n",
        "res[\"arquitetura_norm\"] = (\n",
        "    res[\"arquitetura\"].astype(str).str.strip().str.lower()\n",
        "    .str.replace(\"ú\", \"u\", regex=False)\n",
        ")\n",
        "\n",
        "mapeamento_arquitetura = {\n",
        "    \"agente unico\": \"Agente único\",\n",
        "    \"gerador + verificador\": \"Gerador + verificador\",\n",
        "    \"supervisor\": \"Supervisor\",\n",
        "}\n",
        "\n",
        "agr = (\n",
        "    res.groupby([\"framework\", \"arquitetura_norm\"], as_index=False)\n",
        "    .agg(\n",
        "        acerto_juiz=(\"juiz\", \"sum\"),\n",
        "        acerto_automatico=(\"automatica\", \"sum\"),\n",
        "        chamadas=(\"chamadas\", \"sum\"),\n",
        "        segundos=(\"segundos\", \"sum\"),\n",
        "        perguntas=(\"pergunta\", \"nunique\"),\n",
        "    )\n",
        ")\n",
        "\n",
        "agr[\"arquitetura\"] = agr[\"arquitetura_norm\"].map(mapeamento_arquitetura).fillna(agr[\"arquitetura_norm\"])\n",
        "agr[\"segundos\"] = agr[\"segundos\"].round()\n",
        "\n",
        "display_cols = [\n",
        "    \"framework\", \"arquitetura\", \"acerto_juiz\", \"acerto_automatico\", \"chamadas\", \"segundos\", \"perguntas\"\n",
        "]\n",
        "print(\"=== RESUMO FINAL (DINÂMICO) ===\")\n",
        "display(agr[display_cols].sort_values([\"framework\", \"arquitetura\"]))\n",
        "\n",
        "linhas_resumo = []\n",
        "for framework in sorted(agr[\"framework\"].unique()):\n",
        "    bloco = agr[agr[\"framework\"] == framework].copy()\n",
        "    total_q = int(bloco[\"perguntas\"].max()) if not bloco.empty else 0\n",
        "\n",
        "    melhor_juiz = bloco.sort_values([\"acerto_juiz\", \"acerto_automatico\", \"chamadas\"], ascending=[False, False, True]).iloc[0]\n",
        "    melhor_custo = bloco.sort_values([\"chamadas\", \"segundos\", \"acerto_juiz\"], ascending=[True, True, False]).iloc[0]\n",
        "\n",
        "    linhas_resumo.append(\n",
        "        f\"- {framework}: melhor acerto no juiz = {melhor_juiz['arquitetura']} \"\n",
        "        f\"({int(melhor_juiz['acerto_juiz'])}/{total_q}); \"\n",
        "        f\"menor custo = {melhor_custo['arquitetura']} \"\n",
        "        f\"({int(melhor_custo['chamadas'])} chamadas, {int(melhor_custo['segundos'])} s).\"\n",
        "    )\n",
        "\n",
        "print(\"\\n=== CONCLUSAO AUTOMATICA ===\")\n",
        "for l in linhas_resumo:\n",
        "    print(l)\n",
        "\n",
        "if set([\"LangGraph\", \"CrewAI\"]).issubset(set(agr[\"framework\"])):\n",
        "    comp = (\n",
        "        agr.groupby(\"framework\", as_index=False)\n",
        "        .agg(\n",
        "            acerto_juiz_total=(\"acerto_juiz\", \"sum\"),\n",
        "            chamadas_totais=(\"chamadas\", \"sum\"),\n",
        "            segundos_totais=(\"segundos\", \"sum\"),\n",
        "        )\n",
        "        .sort_values([\"acerto_juiz_total\", \"chamadas_totais\", \"segundos_totais\"], ascending=[False, True, True])\n",
        "    )\n",
        "    top = comp.iloc[0]\n",
        "    print(\"\\n=== FRAMEWORK COM MELHOR RELACAO ACERTO/CUSTO NESTA EXECUCAO ===\")\n",
        "    print(\n",
        "        f\"{top['framework']} \"\n",
        "        f\"(acerto_juiz_total={int(top['acerto_juiz_total'])}, \"\n",
        "        f\"chamadas_totais={int(top['chamadas_totais'])}, \"\n",
        "        f\"segundos_totais={int(top['segundos_totais'])}).\"\n",
        "    )"
