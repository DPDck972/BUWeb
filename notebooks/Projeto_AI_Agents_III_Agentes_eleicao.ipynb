        "\n",
        "# ═══════════════════════════════════════════════════════════════════════════\n",
        "# 2. CHECAGEM AUTOMÁTICA\n",
        "# ═══════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "def checagem(p, r):\n",
        "    \"\"\"Checagem automática para o domínio eleitoral do TSE.\"\"\"\n",
        "    resp = r[\"resposta\"].lower()\n",
        "    resp_num = resp.replace(\".\", \"\").replace(\",\", \"\")\n",
        "    falhas = []\n",
        "\n",
        "    # termos obrigatórios — aceita com ou sem separador de milhar\n",
        "    for term in p.get(\"checar\", []):\n",
        "        t_low = str(term).lower()\n",
        "        t_num = t_low.replace(\".\", \"\").replace(\",\", \"\")\n",
        "        if not (re.search(re.escape(t_low), resp) or re.search(re.escape(t_num), resp_num)):\n",
        "            falhas.append(f\"faltou '{term}'\")\n",
        "\n",
        "    # termos proibidos\n",
        "    for term in p.get(\"proibido\", []):\n",
        "        if re.search(re.escape(str(term).lower()), resp):\n",
        "            falhas.append(f\"contém termo proibido '{term}'\")\n",
        "\n",
        "    # perguntas de recusa exigem um gatilho explícito de recusa\n",
        "    if p[\"tipo\"] == \"recusa\":\n",
        "        gatilhos = [\"não existe\", \"não está\", \"não tenho\", \"não posso\",\n",
        "                    \"não fornece\", \"não disponível\", \"não consta\",\n",
        "                    \"fora do escopo\", \"não faz parte\", \"não há\",\n",
        "                    \"só respondo\", \"apenas sobre\", \"não contempla\",\n",
        "                    \"não encontrad\", \"não foi encontrado\"]\n",
        "        if not any(g in resp for g in gatilhos):\n",
        "            falhas.append(\"não recusou\")\n",
        "\n",
        "    return falhas\n",
        "\n",
        "# ═══════════════════════════════════════════════════════════════════════════\n",
        "# 3. JUIZ SEMÂNTICO\n",
        "# ═══════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "class AvaliacaoJuiz(BaseModel):\n",
        "    correta: bool = Field(description=\"True if the answer is factually correct, matching the reference facts\")\n",
        "    motivo: str = Field(description=\"brief explanation of the grade\")\n",
        "\n",
        "JUIZ = \"\"\"You grade answers of an election audit assistant. You get the question, a reference with the true facts,\n",
        "and the assistant's answer. The answer is correct if it agrees with the reference and every number, zone/section,\n",
        "and comparison in it is true. Extra details that do not contradict the reference are fine.\n",
        "Do not penalize an answer for being cut off at the end.\n",
        "\n",
        "IMPORTANT — lists and rankings:\n",
        "When the question asks for a ranking or a list (\"quais seções têm mais...\"), the reference may list only the top\n",
        "items while the answer lists more. If every item in the answer is consistent with the reference's top item and\n",
        "the answer's first item matches the reference's first item, the answer is CORRECT. Do not penalize an answer for\n",
        "listing additional sections that the reference does not mention, as long as the top item and its value match.\n",
        "\n",
        "IMPORTANT — refusals:\n",
        "When the reference says the data does not exist or is out of scope, any answer that clearly states the data is\n",
        "not in the file (e.g. \"não está no arquivo\", \"não existe\", \"não foi encontrado\") is CORRECT.\"\"\"\n",
        "\n",
        "juiz = modelo(max_tokens=400).with_structured_output(AvaliacaoJuiz)\n",
