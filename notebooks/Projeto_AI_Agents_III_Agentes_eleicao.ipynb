        "# @title 🔧 Utilitários: como subir o servidor, o modelo e funções para imprimir\n",
        "import json, re\n",
        "from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage\n",
        "from langchain_ollama import ChatOllama\n",
        "\n",
        "# Como o notebook sobe o servidor: o mesmo Python, mas com as bibliotecas de servidor_libs/ na frente\n",
        "SERVIDOR = {\"eleicao\": {\"transport\": \"stdio\", \"command\": sys.executable, \"args\": [\"server.py\"],\n",
        "                        \"env\": {\"PYTHONPATH\": SERVER_LIBS, \"BU_DATA_PATH\": CSV_PATH,\n",
        "                                \"FASTMCP_LOG_LEVEL\": \"ERROR\", \"FASTMCP_SHOW_SERVER_BANNER\": \"false\"}}}\n",
        "\n",
        "CHAMADAS = 0                                   # quantas vezes o modelo foi chamado na pergunta atual\n",
        "\n",
        "def modelo(pensar=False, max_tokens=600):\n",
        "    \"\"\"O qwen3:8b no Ollama, com temperatura zero. pensar=True liga o raciocínio do qwen3 (mais lento).\"\"\"\n",
        "    return ChatOllama(model=MODEL, temperature=0, num_ctx=8192, num_predict=max_tokens, reasoning=pensar)\n",
        "\n",
        "async def chamar(llm, mensagens):\n",
        "    \"\"\"Chama o modelo e conta a chamada.\"\"\"\n",
        "    global CHAMADAS\n",
        "    CHAMADAS += 1\n",
        "    return await llm.ainvoke(mensagens)\n",
        "\n",
        "def texto(conteudo):\n",
        "    \"\"\"O texto de um resultado de ferramenta (o adaptador MCP entrega uma lista de blocos).\"\"\"\n",
        "    if isinstance(conteudo, str):\n",
        "        return conteudo\n",
        "    return \"\".join(b.get(\"text\", \"\") if isinstance(b, dict) else str(b) for b in conteudo)\n",
        "\n",
        "def resumo(resultado):\n",
        "    \"\"\"Uma linha genérica e segura sobre o resultado de uma ferramenta para o trace.\"\"\"\n",
        "    try:\n",
        "        d = json.loads(resultado)\n",
        "    except json.JSONDecodeError:\n",
        "        return \"erro: \" + resultado.splitlines()[0][:90]\n",
        "    if isinstance(d, dict) and \"error\" in d:\n",
        "        return \"erro: \" + d[\"error\"]\n",
        "\n",
        "    # Se forem dados do Boletim de Urna (BU)\n",
        "    if isinstance(d, dict) and \"secao\" in d and \"zona\" in d:\n",
        "        return f\"Zona {d['zona']}, Seção {d['secao']}, município {d.get('municipio', '')} · {d.get('comparecimento', 0)} compareceram\"\n",
        "    if isinstance(d, dict) and \"total_votos\" in d:\n",
        "        return f\"Total de votos: {d['total_votos']} ({d.get('tipo_voto', 'votos')})\"\n",
        "    if isinstance(d, dict) and \"total_sem_biometria\" in d:\n",
        "        return f\"Sem biometria: {d['total_sem_biometria']} de {d.get('total_aptos', 0)} ({d.get('percentual', 0)}%)\"\n",
        "    if isinstance(d, dict) and \"best\" in d:\n",
        "        return \"melhor em cada critério: \" + \", \".join(f\"{k} {'/'.join(v)}\" for k, v in d[\"best\"].items())\n",
        "\n",
        "    return str(d)[:90]\n",
        "\n",
        "def mostrar(r):\n",
        "    \"\"\"O trace de uma execução: cada pedido de ferramenta, cada resultado e as mensagens entre agentes.\"\"\"\n",
        "    for m in r[\"messages\"][1:]:\n",
        "        nome = getattr(m, \"name\", None)\n",
        "        if isinstance(m, AIMessage) and m.tool_calls:\n",
        "            for c in m.tool_calls:\n",
        "                print(f\"   🤖 pede        → {c['name']}({json.dumps(c['args'], ensure_ascii=False)})\")\n",
        "        elif isinstance(m, ToolMessage):\n",
        "            print(f\"   📡 servidor    → {resumo(texto(m.content))}\")\n",
        "        elif nome == \"verificador\":\n",
        "            print(f\"   🔍 verificador → {m.content[:300]}\")\n",
        "        elif nome == \"supervisor\":\n",
        "            print(f\"   🧭 supervisor  → {m.content[:160]}\")\n",
        "        elif nome in (\"buscador\", \"comparador\"):\n",
        "            print(f\"   📋 {nome:<11} → {m.content.replace(chr(10), ' ')[:160]}…\")\n",
