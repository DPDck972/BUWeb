        "### 📊 Visualização Gráfica do Benchmark: Taxa de Acerto do Juiz Semântico\n",
        "\n",
        "Vamos consolidar os dados de acerto do Juiz Semântico para cada framework e arquitetura e plotá-los em um gráfico de barras comparativo."
      ],
      "id": "242d2c1c"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 601
        },
        "id": "885f8852",
        "outputId": "8509427a-06a2-4e8d-ac45-376958ba6df2"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Configurando os dados consolidados obtidos do DataFrame de resultados\n",
        "df_grafico = resultados.groupby([\"framework\", \"arquitetura\"], as_index=False).agg(\n",
        "    acertos=(\"juiz\", \"sum\"),\n",
        "    total=(\"pergunta\", \"nunique\")\n",
        ")\n",
        "df_grafico[\"taxa_acerto\"] = (df_grafico[\"acertos\"] / df_grafico[\"total\"]) * 100\n",
        "\n",
        "# Padronizando nomes para exibição no gráfico\n",
        "mapeamento_nomes = {\n",
        "    \"agente único\": \"Agente Único\",\n",
        "    \"gerador + verificador\": \"Gerador + Verificador\",\n",
        "    \"supervisor\": \"Supervisor\"\n",
        "}\n",
        "df_grafico[\"arquitetura\"] = df_grafico[\"arquitetura\"].map(mapeamento_nomes).fillna(df_grafico[\"arquitetura\"])\n",
        "\n",
        "# 2. Renderizando o gráfico de barras comparativo\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.barplot(\n",
        "    x=\"arquitetura\",\n",
        "    y=\"taxa_acerto\",\n",
        "    hue=\"framework\",\n",
        "    data=df_grafico,\n",
        "    palette=[\"#4A90E2\", \"#F5A623\"], # Azul para LangGraph, Laranja para CrewAI\n",
        "    edgecolor=\"black\",\n",
        "    linewidth=1\n",
        ")\n",
        "\n",
        "# Customizações visuais\n",
