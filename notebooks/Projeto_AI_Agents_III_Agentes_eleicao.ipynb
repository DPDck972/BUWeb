      "source": [
        "---\n",
        "# Parte 5 · As mesmas arquiteturas no CrewAI\n",
        "\n",
        "Agora repetimos o experimento com o mesmo dominio eleitoral e o mesmo `server.py`, mas trocando o orquestrador para o CrewAI.\n",
        "\n",
        "Objetivo:\n",
        "- manter as mesmas ferramentas MCP e o mesmo CSV de eleicoes;\n",
        "- medir as mesmas perguntas da Parte 4;\n",
        "- comparar custo e acerto entre LangGraph e CrewAI no final."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cell-27",
        "outputId": "1fe6e441-0728-48ee-d81f-a098a4fc1006",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "execution_count": 62,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "crews prontas: total_por_tipo, total_sem_biometria, secao_details, compare_secoes, search_secoes, soma_secoes\n"
          ]
        }
      ],
      "source": [
        "import logging\n",
        "logging.getLogger(\"crewai\").setLevel(logging.ERROR)\n",
        "import sys\n",
        "import os\n",
        "import time\n",
        "import json\n",
        "\n",
        "# Garante a instalação do crewai se não estiver presente\n",
        "try:\n",
        "    from crewai import Agent, Task, Crew, Process, LLM\n",
        "    from crewai.events import crewai_event_bus\n",
        "    from crewai.events.types.llm_events import LLMCallCompletedEvent\n",
        "    from crewai.events.types.tool_usage_events import ToolUsageStartedEvent, ToolUsageFinishedEvent\n",
        "    from crewai_tools import MCPServerAdapter\n",
        "    from mcp import StdioServerParameters\n",
        "except ImportError:\n",
        "    import subprocess\n",
        "    print(\"Instalando dependências do CrewAI...\")\n",
        "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"crewai>=0.150\", \"crewai-tools[mcp]>=0.60\"], check=True)\n",
        "    from crewai import Agent, Task, Crew, Process, LLM\n",
        "    from crewai.events import crewai_event_bus\n",
        "    from crewai.events.types.llm_events import LLMCallCompletedEvent\n",
        "    from crewai.events.types.tool_usage_events import ToolUsageStartedEvent, ToolUsageFinishedEvent\n",
        "    from crewai_tools import MCPServerAdapter\n",
        "    from mcp import StdioServerParameters\n",
        "\n",
        "llm_crew = LLM(model=f\"ollama_chat/{MODEL}\", base_url=OLLAMA_URL, temperature=0,\n",
        "               reasoning_effort=\"none\", context_window_size=8192,\n",
        "               max_tokens=800, frequency_penalty=0.3)\n",
        "\n",
        "if \"mcp_crew\" in globals():\n",
        "    try:\n",
        "        mcp_crew.stop()\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "mcp_crew = MCPServerAdapter(StdioServerParameters(command=sys.executable, args=[\"server.py\"],\n",
        "                                                  env=SERVIDOR[\"eleicao\"][\"env\"]))\n",
        "T = {f.name: f for f in mcp_crew.tools}\n",
        "ESTOQUE = set(T)\n",
        "\n",
        "RESPOSTA = \"Responda em portugues, com fatos do BU e citando zona e secao quando houver.\"\n",
        "ASSISTENTE = dict(\n",
        "    role=\"Assistente de auditoria eleitoral RN\",\n",
        "    goal=\"Responder perguntas sobre BUWeb com base exclusiva nos dados das ferramentas\",\n",
        "    backstory=\"Voce usa apenas as ferramentas de eleicoes e nunca inventa numeros ou secoes.\",\n",
        ")\n",
        "\n",
        "def crew_unico():\n",
        "    assistente = Agent(**ASSISTENTE, tools=list(T.values()), llm=llm_crew, max_iter=6)\n",
        "    return Crew(agents=[assistente], tasks=[Task(description=\"Pergunta do usuario: {pedido}\", expected_output=RESPOSTA, agent=assistente)])\n",
        "\n",
        "def crew_dupla():\n",
        "    assistente = Agent(**ASSISTENTE, tools=list(T.values()), llm=llm_crew, max_iter=6)\n",
        "    verificador = Agent(\n",
        "        role=\"Verificador factual eleitoral\", goal=\"Conferir se zona, secao e numeros da resposta batem com as ferramentas\",\n",
        "        backstory=\"Voce revisa fatos e corrige respostas com base em evidencias do BU.\",\n",
        "        tools=[T[\"secao_details\"], T[\"compare_secoes\"], T[\"total_por_tipo\"], T[\"soma_secoes\"]], llm=llm_crew, max_iter=6)\n",
        "    responder = Task(description=\"Customer request: {pedido}\", expected_output=RESPOSTA, agent=assistente)\n",
        "    conferir = Task(description=\"Customer request: {pedido}\\nCheck the answer against the data and return the corrected final answer.\",\n",
        "                    expected_output=RESPOSTA, agent=verificador, context=[responder])\n",
        "    return Crew(agents=[assistente, verificador], tasks=[responder, conferir])\n",
        "\n",
        "GERENTE = \"\"\"Voce coordena dois especialistas para auditoria de eleicoes no RN.\n",
        "- buscador: encontra rankings e totais gerais (search_secoes, total_por_tipo, total_sem_biometria).\n",
        "- comparador: detalha e compara secoes especificas (secao_details, compare_secoes, soma_secoes).\n",
        "Delegue uma tarefa precisa por vez e responda ao usuario apenas com fatos dos relatorios.\n",
        "Nunca invente secao, municipio ou numero.\"\"\"\n",
        "\n",
        "def crew_supervisor():\n",
        "    buscador = Agent(\n",
        "        role=\"buscador\",\n",
        "        goal=\"Buscar rankings e totais de votos no BU\",\n",
        "        backstory=\"Especialista em busca e agregacao de secoes.\",\n",
        "        tools=[T[\"search_secoes\"], T[\"total_por_tipo\"], T[\"total_sem_biometria\"], T[\"soma_secoes\"]],\n",
        "        llm=llm_crew,\n",
        "        max_iter=6,\n",
        "    )\n",
        "    comparador = Agent(\n",
        "        role=\"comparador\",\n",
        "        goal=\"Comparar e detalhar secoes especificas\",\n",
        "        backstory=\"Especialista em comparacao de secoes e conferencia numericas.\",\n",
        "        tools=[T[\"secao_details\"], T[\"compare_secoes\"], T[\"soma_secoes\"]],\n",
        "        llm=llm_crew,\n",
        "        max_iter=6,\n",
        "    )\n",
        "    gerente = Agent(\n",
        "        role=\"supervisor\",\n",
        "        goal=\"Responder ao usuario delegando para o especialista correto\",\n",
        "        backstory=GERENTE,\n",
        "        llm=llm_crew,\n",
        "        allow_delegation=True,\n",
        "        max_iter=8,\n",
        "    )\n",
        "\n",
        "    return Crew(\n",
        "        agents=[buscador, comparador],\n",
        "        tasks=[Task(description=\"Pergunta do usuario: {pedido}\", expected_output=RESPOSTA)],\n",
        "        process=Process.hierarchical,\n",
        "        manager_agent=gerente,\n",
        "    )\n",
        "\n",
        "async def rodar_crew(montar, pergunta, ver=True):\n",
        "    passos, t = [], time.time()\n",
        "    with crewai_event_bus.scoped_handlers():\n",
        "        @crewai_event_bus.on(LLMCallCompletedEvent)\n",
        "        def conta_chamada(fonte, ev):\n",
        "            passos.append(dict(tipo=\"modelo\", agente=getattr(ev, \"agent_role\", \"?\"), t=time.time() - t))\n",
        "        @crewai_event_bus.on(ToolUsageStartedEvent)\n",
        "        def anota_delegacao(fonte, ev):\n",
        "            if ev.tool_name not in ESTOQUE:\n",
        "                passos.append(dict(tipo=\"delegou\", agente=getattr(ev, \"agent_role\", \"?\"), t=time.time() - t, args=ev.tool_args))\n",
        "        @crewai_event_bus.on(ToolUsageFinishedEvent)\n",
        "        def anota_ferramenta(fonte, ev):\n",
        "            passos.append(dict(tipo=\"ferramenta\", agente=getattr(ev, \"agent_role\", \"?\"), t=time.time() - t,\n",
        "                               nome=ev.tool_name, args=ev.tool_args, saida=str(ev.output)))\n",
        "        saida = await montar().kickoff_async(inputs={\"pedido\": pergunta})\n",
        "        crewai_event_bus.flush()\n",
        "    r = {\"resposta\": saida.raw,\n",
        "         \"ferramentas\": [p[\"nome\"] for p in passos if p[\"tipo\"] == \"ferramenta\" and p[\"nome\" ] in ESTOQUE],\n",
        "         \"chamadas\": sum(p[\"tipo\"] == \"modelo\" for p in passos), \"segundos\": round(time.time() - t, 1), \"passos\": passos}\n",
        "    if ver:\n",
        "        print(f\"👤 {pergunta}\\n\")\n",
        "        mostrar_crew(r)\n",
        "    return r\n",
        "\n",
        "def mostrar_crew(r):\n",
        "    for p in r[\"passos\"]:\n",
        "        args = p.get(\"args\") if isinstance(p.get(\"args\"), dict) else {}\n",
        "        quando = f\"[{p['t']:5.1f} s]\"\n",
        "        if p[\"tipo\"] == \"delegou\":\n",
        "            print(f\"{quando} 🧭 supervisor → {args.get('coworker', '?')}: {str(args.get('task') or args.get('question', ''))[:140]}\")\n",
        "        elif p[\"tipo\"] == \"ferramenta\" and p[\"nome\"] in ESTOQUE:\n",
        "            print(f\"{quando} 🤖 {p['agente']:<10} pede → {p['nome']}({json.dumps(args, ensure_ascii=False)})\")\n",
        "            print(f\"{'':10}📡 servidor   → {resumo(p['saida'])}\")\n",
        "        elif p[\"tipo\"] == \"ferramenta\":\n",
        "            print(f\"{quando} 📋 {args.get('coworker', '?'):<10} → {p['saida'].replace(chr(10), ' ')[:560]}…\")\n",
        "    print(f\"\\n💬 {r['resposta']}\\n\")\n",
        "    print(f\"⏱ {r['chamadas']} chamadas ao modelo · {r['segundos']} s\")\n",
        "\n",
        "print(\"crews prontas:\", \", \".join(T))"
      ],
