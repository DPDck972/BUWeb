        "from typing import Literal\n",
        "from pydantic import BaseModel, Field\n",
        "\n",
        "class Rota(BaseModel):\n",
        "    proximo: Literal[\"buscador\", \"comparador\", \"answer\"] = Field(description=\"who acts next\")\n",
        "    tarefa: str = Field(description=\"the instruction for the specialist, with parameters/filters; empty for 'answer'\")\n",
        "\n",
        "SUPERVISOR = \"\"\"You coordinate two specialists for an election audit assistant in RN, Brazil.\n",
        "- buscador: finds section groups, lists tops, or calculates general statistics (tools: search_secoes, total_por_tipo, total_sem_biometria).\n",
        "- comparador: compares 2 specific sections or sums their votes (tools: compare_secoes, secao_details, soma_secoes).\n",
        "Read the request and the reports so far, and pick who acts next with a precise task.\n",
        "Pick 'answer' as soon as the reports are enough to answer the user.\"\"\"\n",
        "\n",
        "REDATOR = SYSTEM + \"\\nWrite the final answer to the user using only the specialists' reports in Portuguese.\"\n",
        "\n",
        "class EstadoSupervisor(TypedDict):\n",
        "    messages: Annotated[list, add_messages]\n",
        "    relatorios: list                                          # o que os especialistas devolveram\n",
        "    proximo: str\n",
        "    tarefa: str\n",
        "\n",
        "def supervisor_especialistas(ferramentas, max_passos=4):\n",
        "    t = {f.name: f for f in ferramentas}\n",
        "    especialistas = {\n",
        "        \"buscador\":   agente([t[\"search_secoes\"], t[\"total_por_tipo\"], t[\"total_sem_biometria\"]], SYSTEM + \"\\nYou are the search specialist. Do the task and report the facts.\"),\n",
        "        \"comparador\": agente([t[\"compare_secoes\"], t[\"secao_details\"], t[\"soma_secoes\"]], SYSTEM + \"\\nYou are the comparison specialist. Do the task and report the facts.\"),\n",
        "    }\n",
        "    roteador = modelo(max_tokens=200).with_structured_output(Rota)\n",
        "    redator = modelo(max_tokens=900)\n",
        "\n",
        "    def briefing(estado):\n",
        "        rel = \"\\n\".join(estado.get(\"relatorios\", [])) or \"(none yet)\"\n",
        "        return f\"USER REQUEST:\\n{estado['messages'][0].content}\\n\\nSPECIALIST REPORTS:\\n{rel}\"\n",
        "\n",
        "    async def no_supervisor(estado):\n",
        "        if len(estado.get(\"relatorios\", [])) >= max_passos:  # teto de passos\n",
        "            return {\"proximo\": \"answer\", \"tarefa\": \"\"}\n",
        "        rota = await chamar(roteador, [SystemMessage(SUPERVISOR), HumanMessage(briefing(estado))])\n",
        "        return {\"proximo\": rota.proximo, \"tarefa\": rota.tarefa,\n",
        "                \"messages\": [AIMessage(f\"{rota.proximo}: {rota.tarefa}\", name=\"supervisor\")]}\n",
        "\n",
        "    def especialista(nome):\n",
        "        async def no(estado):\n",
        "            out = await especialistas[nome].ainvoke({\"messages\": [HumanMessage(estado[\"tarefa\"])]})   # só a tarefa\n",
        "            relatorio = f\"[{nome}] {out['messages'][-1].content}\"\n",
        "            return {\"messages\": out[\"messages\"][1:-1] + [AIMessage(relatorio, name=nome)],\n",
        "                    \"relatorios\": estado.get(\"relatorios\", []) + [relatorio]}\n",
        "        return no\n",
        "\n",
        "    async def no_redator(estado):\n",
        "        return {\"messages\": [await chamar(redator, [SystemMessage(REDATOR), HumanMessage(briefing(estado))])]}\n",
        "\n",
        "    g = StateGraph(EstadoSupervisor)\n",
        "    g.add_node(\"supervisor\", no_supervisor)\n",
        "    for nome in especialistas:\n",
        "        g.add_node(nome, especialista(nome))\n",
        "        g.add_edge(nome, \"supervisor\")\n",
        "    g.add_node(\"redator\", no_redator)\n",
        "    g.add_edge(START, \"supervisor\")\n",
        "    g.add_conditional_edges(\"supervisor\", lambda e: e[\"proximo\"],\n",
        "                            {\"buscador\": \"buscador\", \"comparador\": \"comparador\", \"answer\": \"redator\"})\n",
        "    g.add_edge(\"redator\", END)\n",
        "    return g.compile()\n",
        "\n",
        "equipe = supervisor_especialistas(TOOLS)\n",
        "r = await rodar(equipe, PEDIDO)"
      ]
    },
