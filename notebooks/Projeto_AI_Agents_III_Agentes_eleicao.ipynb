        "# @title ⬇️ Download do Boletim de Urna (BUWeb) oficial do TSE\n",
        "from pathlib import Path\n",
        "import re\n",
        "import zipfile\n",
        "\n",
        "import pandas as pd\n",
        "import requests\n",
        "\n",
        "# Use UMA das opções abaixo:\n",
        "# 1) informe o link completo copiado do TSE em URL_BU; ou\n",
        "# 2) deixe URL_BU vazio e informe ANO, UF, TURNO e GERACAO_BU.\n",
        "ANO = 2026\n",
        "UF = \"RN\"\n",
        "TURNO = 2\n",
        "GERACAO_BU = \"261020260742\"  # pode ficar vazio se URL_BU for informado\n",
        "URL_BU = \"\"  # exemplo: https://cdn.tse.jus.br/.../bweb_2t_RN_261020260742.zip\n",
        "\n",
        "BASE_DIR = Path.cwd()\n",
        "DADOS_DIR = BASE_DIR / \"planilhas\"\n",
        "DOWNLOADS_DIR = DADOS_DIR / \"downloads\"\n",
        "DADOS_DIR.mkdir(parents=True, exist_ok=True)\n",
        "DOWNLOADS_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "SEPARADOR = \";\"\n",
        "ENCODING_ORIGINAL = \"latin-1\"\n",
        "\n",
        "\n",
        "def url_buweb_tse(ano, turno, uf, geracao):\n",
        "    \"\"\"Monta o link oficial do ZIP de Boletins de Urna do TSE.\"\"\"\n",
        "    return (\n",
        "        f\"https://cdn.tse.jus.br/estatistica/sead/eleicoes/\"\n",
        "        f\"eleicoes{ano}/buweb/bweb_{turno}t_{uf}_{geracao}.zip\"\n",
        "    )\n",
        "\n",
        "\n",
        "UF = UF.strip().upper()\n",
        "GERACAO_BU = str(GERACAO_BU).strip()\n",
        "URL_BU = str(URL_BU).strip()\n",
        "if URL_BU:\n",
        "    if not URL_BU.lower().startswith(\"https://cdn.tse.jus.br/\"):\n",
        "        raise ValueError(\"URL_BU deve apontar para o CDN oficial https://cdn.tse.jus.br/.\")\n",
        "    url_tse = URL_BU\n",
        "    nome_zip_url = Path(url_tse.split(\"?\", 1)[0]).name\n",
        "    padrao_nome = re.fullmatch(r\"bweb_([12])t_([A-Z]{2})_(\\d{12})\\.zip\", nome_zip_url, re.I)\n",
        "    padrao_ano = re.search(r\"/eleicoes(\\d{4})/\", url_tse, re.I)\n",
        "    if not padrao_nome or not padrao_ano:\n",
        "        raise ValueError(\n",
        "            \"URL_BU deve seguir o padrão do BUWeb, por exemplo \"\n",
        "            \"bweb_2t_RN_261020260742.zip.\"\n",
        "        )\n",
        "    TURNO = int(padrao_nome.group(1))\n",
        "    UF = padrao_nome.group(2).upper()\n",
        "    GERACAO_BU = padrao_nome.group(3)\n",
        "    ANO = int(padrao_ano.group(1))\n",
        "else:\n",
        "    if not re.fullmatch(r\"[A-Z]{2}\", UF):\n",
        "        raise ValueError(\"UF deve ser uma sigla de dois caracteres, por exemplo RN ou SP.\")\n",
        "    if TURNO not in (1, 2):\n",
        "        raise ValueError(\"TURNO deve ser 1 ou 2.\")\n",
        "    if not isinstance(ANO, int) or not 2000 <= ANO <= 2100:\n",
        "        raise ValueError(\"ANO deve ser um ano eleitoral válido, como 2026.\")\n",
        "    if not re.fullmatch(r\"\\d{12}\", GERACAO_BU):\n",
        "        raise ValueError(\n",
        "            \"Sem URL_BU, GERACAO_BU deve conter os 12 dígitos do nome exato do ZIP do TSE.\"\n",
        "        )\n",
        "    url_tse = url_buweb_tse(ANO, TURNO, UF, GERACAO_BU)\n",
        "\n",
        "nome_zip = Path(url_tse.split(\"?\", 1)[0]).name\n",
        "if not nome_zip.lower().endswith(\".zip\"):\n",
        "    raise ValueError(\"URL_BU deve apontar para um arquivo .zip do BUWeb.\")\n",
        "zip_path = DOWNLOADS_DIR / nome_zip\n",
        "ARQUIVO_SAIDA = DADOS_DIR / f\"dados_eleitorais_{UF}_{TURNO}T_{ANO}_enxuto.csv\"\n",
        "\n",
        "if not zip_path.exists():\n",
        "    print(f\"Baixando Boletins de Urna oficiais do TSE: {url_tse}\")\n",
        "    with requests.get(url_tse, stream=True, timeout=120) as resposta:\n",
        "        resposta.raise_for_status()\n",
        "        with zip_path.open(\"wb\") as arquivo:\n",
        "            for bloco in resposta.iter_content(chunk_size=1024 * 1024):\n",
        "                if bloco:\n",
        "                    arquivo.write(bloco)\n",
        "else:\n",
        "    print(f\"ZIP já baixado: {zip_path}\")\n",
        "\n",
        "with zipfile.ZipFile(zip_path) as compactado:\n",
        "    csvs = [nome for nome in compactado.namelist() if nome.lower().endswith(\".csv\")]\n",
        "    if not csvs:\n",
        "        raise RuntimeError(f\"O ZIP do TSE não contém CSV: {zip_path}\")\n",
        "    csv_path = DADOS_DIR / Path(csvs[0]).name\n",
        "    if not csv_path.exists():\n",
        "        with compactado.open(csvs[0]) as origem, csv_path.open(\"wb\") as destino:\n",
        "            destino.write(origem.read())\n",
        "\n",
        "ARQUIVO_ORIGINAL = csv_path\n",
        "print(f\"Fonte oficial: {url_tse}\")\n",
        "print(f\"Arquivo extraído: {ARQUIVO_ORIGINAL}\")\n",
        "\n",
        "colunas = pd.read_csv(\n",
        "    ARQUIVO_ORIGINAL,\n",
        "    sep=SEPARADOR,\n",
        "    encoding=ENCODING_ORIGINAL,\n",
        "    dtype=str,\n",
        "    keep_default_na=False,\n",
        "    nrows=0,\n",
        ").columns\n",
        "colunas_esperadas = {\n",
        "    \"DS_CARGO_PERGUNTA\", \"DS_TIPO_VOTAVEL\", \"QT_VOTOS\",\n",
        "    \"QT_APTOS\", \"QT_COMPARECIMENTO\", \"QT_ABSTENCOES\",\n",
        "    \"QT_ELEI_BIOM_SEM_HABILITACAO\",\n",
        "}\n",
        "faltando = sorted(colunas_esperadas.difference(colunas))\n",
        "if faltando:\n",
        "    raise ValueError(f\"O arquivo não tem o layout de BU esperado. Colunas ausentes: {faltando}\")\n",
        "\n",
        "print(\"Layout de BU validado: Governador/Presidente, tipos de voto e dados eleitorais disponíveis.\")"
      ]
    },
