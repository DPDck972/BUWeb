        "    print(f\"⏱ {r['chamadas']} chamadas ao modelo · {r['segundos']} s\")\n",
        "\n",
        "def extrair_resposta(msgs):\n",
        "    \"\"\"A resposta final: a última AIMessage sem tool_calls.\n",
        "    Prefere a do gerador (name=None); se não houver, aceita a do verificador.\"\"\"\n",
        "    # 1ª tentativa: mensagem do gerador (sem name)\n",
        "    for m in reversed(msgs):\n",
        "        if isinstance(m, AIMessage) and not m.tool_calls and m.name is None:\n",
        "            return m.content\n",
        "    # 2ª tentativa: mensagem do verificador (que agora carrega a resposta original)\n",
        "    for m in reversed(msgs):\n",
        "        if isinstance(m, AIMessage) and not m.tool_calls and m.name == \"verificador\":\n",
        "            return m.content\n",
        "    return \"\"\n",
        "\n",
        "async def rodar(app, pergunta, ver=True):\n",
        "    \"\"\"Roda uma arquitetura numa pergunta e devolve a resposta, a trajetória, as chamadas e o tempo.\"\"\"\n",
        "    global CHAMADAS\n",
        "    CHAMADAS, t = 0, time.time()\n",
        "    out = await app.ainvoke({\"messages\": [HumanMessage(pergunta)]}, {\"recursion_limit\": 40})\n",
        "    msgs = out[\"messages\"]\n",
        "    r = {\"resposta\": extrair_resposta(msgs),\n",
        "         \"ferramentas\": [c[\"name\"] for m in msgs if isinstance(m, AIMessage) for c in m.tool_calls],\n",
